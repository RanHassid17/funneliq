# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/

# macOS / iCloud sync duplicates ("invariants 2.py"). A set of these was
# committed once and broke the test run: pytest collected the stale copies
# alongside the real modules.
* 2.*
* copy.*
* copy [0-9].*

# Local data dumps (the source dataset itself is tracked under data/)
*.db
*.sqlite3
data/scratch/
