# Copy to .env for local development. .env is gitignored and must never be committed.
# On Railway these are set as service environment variables, not from a file.

# --- Supabase ---------------------------------------------------------------
# Project URL and the PUBLIC anon key. Both are safe in the browser; the anon
# key is what the login screen uses.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# SERVER-SIDE ONLY. This key bypasses Row Level Security. It must never appear
# in static/, in a Stitch prompt, in a screenshot, or in any committed file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used server-side to verify the JWT a signed-in browser sends us.
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Runtime ----------------------------------------------------------------
# Railway injects PORT. Set it locally only if 8000 is taken.
PORT=8000

# --- CrewAI analyst (Phase 6, OPTIONAL) -------------------------------------
# The only part of FunnelIQ that costs money per request. When unset, /api/ask
# returns 503 with a clear message, the dashboard hides the ask panel, and every
# other feature works normally.
ANTHROPIC_API_KEY=

# Provider-prefixed, as CrewAI expects. Drop to a smaller model here if runtime
# cost matters more than answer quality.
FUNNELIQ_LLM_MODEL=anthropic/claude-sonnet-5
